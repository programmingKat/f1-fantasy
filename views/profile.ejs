<!doctype html>
<html>

<head>
    <title>F1 Fantasy</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Racing+Sans+One&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <div class="container">

        <div class="page-header text-center">
            <h1><span class="fa fa-anchor"></span> Profile Page</h1>
            <a href="/logout" class="btn btn-default btn-sm">Logout</a>
        </div>

        <div class="row">

            <!-- LOCAL INFORMATION -->
            <div class="col-sm-6">
                <div class="well">
                    <h3><span class="fa fa-user"></span> Local</h3>

                    <% if (user.local.email) { %>
                        <p>
                            <strong>id</strong>: <%= user._id %><br>
                                <strong>email</strong>: <%= user.local.email %><br>
                                    <strong>password</strong>:
                        </p>

                        <a href="/unlink/local" class="btn btn-default">Unlink</a>
                        <% } else { %>
                            <a href="/connect/local" class="btn btn-default">Connect Local</a>
                            <% } %>

                </div>
            </div>
            <div class="col-sm-6">
                <h3>Your Team</h3>
                <ul class="messages">
                    <% for(var i=0; i<books.length; i++) {%>
                        <li class="message">

                            <span data-user-id="<%= books[i]._id %>">
                                <%= books[i].title %>
                            </span>
                            <span>
                                <%= books[i].author %>
                            </span>

                            <span>
                                <input type="range" class="rate" id="rating" name="rating" min="0" max="10" />
                            </span>
                            <button class="trash" data-book-id="<%= books[i]._id %>">🚮</button>

                            <span>
                                <%= books[i].rating %>
                            </span>
                            <!-- </i> -->
                        </li>
                        <% } %>
                </ul>

                <h2>Create your team</h2>
                <% if (user.local.email) { %>

                    <!-- Title
                    	Author
                    	ISBN - Optional
                    	Date started
                        Status - Not read , In Progress, Finished
                    	
                    	Genre
                    
                        in update:
                    	Rating  1/10 or 1-5? -->
                    <!-- Date Finished -->

                    <form action="/myBooks" method="POST">
                        <input type="text" value="<%= user.local.email %>" name="name" hidden>
                        <fieldset>
                            <legend>Pick your chassis !</legend>
                            <select name="chassis" id="chassis-select">
                                <option value="ferrari">Ferrari</option>
                                <option value="mcLaren">McLaren</option>
                                <option value="mercedes">Mercedes</option>
                                <option value="redBull">Red Bull Racing</option>
                                <option value="williams">Williams</option>
                                <option value="astonMartin">Aston Martin</option>
                                <option value="racingBulls">Racing Bulls</option>
                                <option value="audi">Audi</option>
                                <option value="haas">Haas</option>
                                <option value="alpine">Alpine</option>
                                <option value="cadillac">Cadillac</option>
                            </select>
                        </fieldset>

                        <fieldset>
                            <legend>Driver #1</legend>
                            <label for="driver1Team">Choose Driver #1's Team</label>
                            <select name="driver1Team" class="driver1Team" id="driver1Team">
                                <option value="Ferrari">Ferrari</option>
                                <option value="McLaren">McLaren</option>
                                <option value="Mercedes">Mercedes</option>
                                <option value="Red Bull">Red Bull Racing</option>
                                <option value="Williams">Williams</option>
                                <option value="Aston Martin">Aston Martin</option>
                                <option value="Racing Bulls">Racing Bulls</option>
                                <option value="Audi">Audi</option>
                                <option value="Haas">Haas</option>
                                <option value="Alpine">Alpine</option>
                                <option value="Cadillac">Cadillac</option>
                            </select>


                            <div>
                                <input type="radio" name="driver1Option" value="driverA" />
                                <label id="driver1OptionA" for="inProgress">Driver A</label>
                            </div>

                            <div>
                                <input type="radio" name="driver1Option" value="driverB" />
                                <label id="driver1OptionB" for="read">Driver B</label>
                            </div>
                        </fieldset>
                    <fieldset>
                            <legend>Driver #2</legend>
                            <label for="driver2Team">Choose Driver #2's Team</label>
                            <select name="driver2Team" class="driver2Team" id="driver2Team">
                                <option value="Ferrari">Ferrari</option>
                                <option value="McLaren">McLaren</option>
                                <option value="Mercedes">Mercedes</option>
                                <option value="Red Bull">Red Bull Racing</option>
                                <option value="Williams">Williams</option>
                                <option value="Aston Martin">Aston Martin</option>
                                <option value="Racing Bulls">Racing Bulls</option>
                                <option value="Audi">Audi</option>
                                <option value="Haas">Haas</option>
                                <option value="Alpine">Alpine</option>
                                <option value="Cadillac">Cadillac</option>
                            </select>



  

                        

                        <button type="submit">Submit</button>
                    </form>
            </div>
            <% } %>

        </div>

        <script src="main.js"></script>

</body>

</html>